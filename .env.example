LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
LLM_API_KEY=
PEXELS_API_KEY=
OPENAI_API_KEY=
# Opcional: fotos de Pixabay como fuente adicional
PIXABAY_API_KEY=
# Opcional: fotos web de Google Imágenes (Serper). Sin clave se usa DuckDuckGo (funciona desde casa)
SERPER_API_KEY=
# Opcional: aviso al móvil al terminar la cola nocturna
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional email (Gmail: smtp.gmail.com + an app password, not your normal password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=
# Optional: the YouTube Data API key of ONE Google Cloud project (searches, research panel, radar).
# Several projects to add up quota is against YouTube's API policy: ask Google for more instead and write
# "key:50000" once granted. A development key is used only with YOUTUBE_API_ENTORNO=desarrollo.
YOUTUBE_API_KEY=
YOUTUBE_API_KEY_DEV=

# Voces generadas con GenAIPro (Labs, voces de ElevenLabs): genaipro.io → avatar → Manage Account → API Key.
# Las voces de cada canal se eligen en el estudio → Ajustes → Voces por canal.
GENAIPRO_API_KEY=
