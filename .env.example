LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
LLM_API_KEY=
DEEPSEEK_VISION_MODEL=deepseek-flash
PEXELS_API_KEY=
OPENAI_API_KEY=

# --- Ajustes opcionales (los valores mostrados son los que se usan por defecto) ---
# Escenas que resuelven material de YouTube a la vez (1 = secuencial, como antes).
# MEDIA_CONCURRENCY=3
# Operaciones simultáneas de yt-dlp contra YouTube (búsquedas + descargas).
# YOUTUBE_PARALLEL=4
# 1 = metadatos y subtítulos en una sola extracción por vídeo; 0 = dos pasadas (modo antiguo).
# YOUTUBE_SINGLE_PASS=1
# 1 = descarga los ficheros de Pexels a public/pipeline-assets/<run>/stock; 0 = URL remota.
# PEXELS_DOWNLOAD=1
# compact = [índice, palabra, inicio]; full = objeto por palabra (formato antiguo).
# SEGMENT_WORDS_FORMAT=compact
# Concurrencia del render de Remotion: número de pestañas o porcentaje ("6", "75%"). Vacío = por defecto.
# REMOTION_CONCURRENCY=
# Carpeta de caché de transcripciones y segmentaciones. Vacío = .cache/edit-vid3 en el repo.
# EDIT_VID3_CACHE_DIR=
