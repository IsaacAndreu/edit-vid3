LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
LLM_API_KEY=
DEEPSEEK_VISION_MODEL=deepseek-flash
PEXELS_API_KEY=
OPENAI_API_KEY=
# Opcionales. Proxy residencial (se paga por GB) solo para los bytes de vídeo de
# YouTube (googlevideo.com). Formato: http://usuario:clave@host:puerto
# El pipeline añade el sufijo de sesión fija "-time-30-session-<id>" al usuario.
YOUTUBE_PROXY=
# Opcional. Proxy para metadatos (búsqueda, página/reproductor, subtítulos).
# Si se deja vacío se usa YOUTUBE_PROXY (misma IP para extraer y descargar).
YOUTUBE_METADATA_PROXY=
# Opcional. Carpeta de caché compartida (info de yt-dlp y biblioteca de clips).
# Por defecto: .cache/ en la raíz del repositorio.
YOUTUBE_CACHE_DIR=
# Opcional. Altura máxima de los trozos descargados (por defecto 720).
YOUTUBE_MAX_HEIGHT=720
