{
  "name": "youtube-video-templates",
  "version": "0.1.0",
  "private": true,
  "description": "Data-driven Remotion templates for long-form YouTube videos.",
  "scripts": {
    "start": "remotion studio",
    "render": "remotion render src/index.ts YoutubeVideo --props=example-props.json",
    "typecheck": "tsc --noEmit",
