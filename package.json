    "atlas:render": "remotion render remotion/index.ts AtlasVideo",
    "atlas:anchors": "tsx scripts/atlas/resolve-anchors.ts",
    "atlas:stills": "tsx scripts/atlas/stills.ts",
    "atlas:validate": "tsx scripts/atlas/validate.ts",
    "atlas:compare": "tsx scripts/atlas/compare.ts",
    "atlas:studio": "remotion studio remotion/index.ts"
  },
